{
  "name": "dont-be-late",
  "version": "0.1.0",
  "description": "《别迟到》时间管理文字游戏原型 — 核心引擎 + CLI + Web UI",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sim": "ts-node src/simulator.ts",
    "sim:10k": "ts-node src/simulator.ts 10000",
    "cli": "ts-node src/cli.ts",
    "test": "jest --config jest.config.js src/tests",
    "test:w": "jest --config jest.config.js --watch src/tests",
    "build:engine": "tsc --noEmit",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "build": "npm run build:engine && npm run build:web"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
